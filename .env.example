NODE_ENV=development
PORT=3000
# Em produção, PORT é fornecida pela Hostinger; não fixe essa variável no painel.
# Configure 1 apenas se existir exatamente um proxy confiável à frente do Node.
TRUST_PROXY=0
USER_OFFLINE_TIMEOUT=15000
USER_ACTIVE_TIMEOUT=60000
USER_SESSION_TIMEOUT=1800000
ROOM_CLEANUP_TIMEOUT=1800000
CLEANUP_INTERVAL=10000
POLL_MESSAGES_INTERVAL=2000
POLL_USERS_INTERVAL=3000
POLL_ACTIVITIES_INTERVAL=5000
HEARTBEAT_INTERVAL=5000
MAX_MESSAGE_LENGTH=10000
MAX_ATTACHMENT_SIZE=2097152
MAX_ATTACHMENTS=3
MAX_RECIPIENTS=30
MAX_ROOMS=100
MAX_USERS_PER_ROOM=150
MAX_MESSAGES_PER_ROOM=3000
MAX_UPLOAD_BYTES=268435456
MAX_CONCURRENT_UPLOADS=8
JOIN_RATE_LIMIT=300
JOIN_RATE_WINDOW=300000
MESSAGE_RATE_LIMIT=10
HEARTBEAT_RATE_LIMIT=30
